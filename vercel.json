{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/private/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard.html",
      "destination": "/api/index.js"
    }
  ]
}
