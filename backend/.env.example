# Server Configuration
PORT=
NODE_ENV=

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Authentication (Minimum 32 random characters in production)
JWT_SECRET=

# Initial Administrator Credentials (Used for seed and seed:reset; minimum 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Transactional Email via SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional: Specific CORS origin restriction if deployed across separate domains
ALLOWED_ORIGIN=
